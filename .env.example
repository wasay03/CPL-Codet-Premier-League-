# Copy to backend/.env for local development. On Railway, set these as service variables.
DATABASE_URL=postgresql://cpl:cpl@127.0.0.1:55450/cpl
JWT_SECRET=replace-with-64-random-characters
ADMIN_PASSWORD=change-me-admin
OWNER1_PASSWORD=change-me-owner1
OWNER2_PASSWORD=change-me-owner2
OWNER3_PASSWORD=change-me-owner3
# Shared read-only login for spectators. Not forced to change; only the admin can reset it.
VIEWER_PASSWORD=change-me-viewer
TIMEZONE=Asia/Karachi
# Set to false only for local testing; production forces a password change on first login.
REQUIRE_PASSWORD_CHANGE=true

# --- Abuse protection (defaults suit Railway; see backend/app/config.py for all knobs)
# Proxies in front of the app that append to X-Forwarded-For: Railway = 1, Cloudflare -> Railway = 2.
TRUSTED_PROXY_HOPS=1
# Use Cloudflare's CF-Connecting-IP. Only once the origin accepts traffic from Cloudflare alone.
TRUST_CF_CONNECTING_IP=false
# Per-IP request budget for /api (an office behind one IP shares it).
API_RATE_PER_SEC=30
API_BURST=300
# Login: attempts per IP per minute; wrong passwords per (IP, username) before a 5-minute lock.
LOGIN_ATTEMPTS_PER_MIN=20
LOGIN_FAILURES_BEFORE_LOCK=5
# Live connections: tabs per login, the shared viewer login, per IP, and in total.
WS_MAX_PER_USER=5
WS_MAX_VIEWER=200
WS_MAX_PER_IP=60
WS_MAX_TOTAL=800
# Interactive API docs at /docs. Set true for local development only.
API_DOCS=false
